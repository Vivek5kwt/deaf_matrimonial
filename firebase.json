{
  "react-native": {
    "messaging_android_headless_task_timeout": 30000,
    "messaging_android_notification_channel_id": "default",
    "messaging_android_notification_icon": "ic_launcher",
    "messaging_android_notification_color": "@color/notification_color"
  },
  "firestore": {
    "database": "(default)",
    "location": "eur3",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ]
}
